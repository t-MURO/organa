{
  "name": "organa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:native": "pnpm --filter @organa/app build:native",
    "build:web": "pnpm --filter @organa/app build:web",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @organa/app web",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "verify:yjs-runtime": "pnpm --filter @organa/app verify:yjs-runtime",
    "verify:migrations": "pnpm --filter @organa/app verify:migrations",
    "verify:platform": "pnpm --filter @organa/app verify:platform",
    "verify:performance": "pnpm --filter @organa/app verify:performance",
    "verify:connected:acceptance": "pnpm --filter @organa/app verify:connected:acceptance",
    "verify:connected:acceptance:deletion": "pnpm --filter @organa/app verify:connected:acceptance:deletion",
    "verify:connected:acceptance:full": "pnpm --filter @organa/app verify:connected:acceptance:full",
    "verify:connected:acceptance:web-push": "pnpm --filter @organa/app verify:connected:acceptance:web-push",
    "verify:connected:config": "pnpm --filter @organa/app verify:connected:config",
    "prepare:connected:managed": "node supabase/prepare-managed-acceptance-config.mjs",
    "verify:release:client-config": "pnpm --filter @organa/app verify:release:client-config",
    "verify:release:readiness": "pnpm --filter @organa/app verify:release:readiness",
    "verify:web-push": "pnpm --filter @organa/app verify:web-push",
    "verify:supabase": "pnpm --filter @organa/app verify:supabase"
  },
  "devDependencies": {
    "turbo": "2.10.6",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
