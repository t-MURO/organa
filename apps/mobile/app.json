{
  "expo": {
    "name": "Organa",
    "slug": "organa",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "organa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.organa.mobile"
    },
    "android": {
      "package": "app.organa.mobile",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#e8efe6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Organa",
      "shortName": "Organa",
      "themeColor": "#f4f0e7",
      "backgroundColor": "#f4f0e7",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Organa to use Face ID to unlock your private space."
        }
      ],
      "expo-audio",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.organa.mobile",
          "widgets": [
            {
              "name": "TodayTasksWidget",
              "displayName": "Organa Today",
              "description": "See today's calm task list.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            },
            {
              "name": "NextReminderWidget",
              "displayName": "Organa Next Reminder",
              "description": "See the next task reminder.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
