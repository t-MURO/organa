{
  "expo": {
    "name": "Organa",
    "slug": "organa",
    "version": "0.1.0",
    "icon": "./assets/branding/icon.png",
    "orientation": "default",
    "scheme": "organa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.organa.mobile",
      "buildNumber": "1",
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "app.organa.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f4f0e7",
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "monochromeImage": "./assets/branding/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Organa",
      "shortName": "Organa",
      "themeColor": "#f4f0e7",
      "backgroundColor": "#f4f0e7",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#327061",
          "defaultChannel": "gentle-reminders",
          "icon": "./assets/branding/notification-icon.png"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Organa to use Face ID to unlock your private space."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f0e7",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.organa.mobile.widgets",
          "groupIdentifier": "group.app.organa.mobile",
          "widgets": [
            {
              "name": "TodayTasksWidget",
              "displayName": "Organa Today",
              "description": "See today's calm task list.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            },
            {
              "name": "NextReminderWidget",
              "displayName": "Organa Next Reminder",
              "description": "See the next task reminder.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayTasksWidget",
              "label": "Organa Today",
              "description": "See today's calm task list.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextReminderWidget",
              "label": "Organa Next Reminder",
              "description": "See the next task reminder.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
