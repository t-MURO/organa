{
  "cli": {
    "appVersionSource": "remote",
    "requireCommit": true,
    "version": ">= 21.2.0"
  },
  "build": {
    "preview": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "environment": "preview"
    },
    "local-preview": {
      "autoIncrement": false,
      "environment": "preview",
      "extends": "preview"
    },
    "preview-simulator": {
      "environment": "preview",
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "releaseStatus": "draft",
        "track": "internal"
      },
      "ios": {}
    }
  }
}
