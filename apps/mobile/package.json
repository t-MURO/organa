{
  "name": "@organa/app",
  "version": "0.1.0",
  "private": true,
  "main": "entry.ts",
  "scripts": {
    "android": "expo run:android",
    "build:android": "expo export --platform android --output-dir dist-android --clear",
    "build:ios": "expo export --platform ios --output-dir dist-ios --clear",
    "build:native": "pnpm build:ios && pnpm build:android",
    "build:web": "expo export --platform web && workbox generateSW workbox-config.cjs && node scripts/verify-web-build.mjs",
    "dev": "expo start",
    "eas-build-pre-install": "node scripts/verify-release-client-config.mjs",
    "ios": "expo run:ios",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "verify:yjs-runtime": "node scripts/verify-yjs-dev-runtime.mjs",
    "verify:connected:acceptance": "node scripts/verify-connected-acceptance.mjs",
    "verify:connected:acceptance:backend": "node scripts/verify-connected-acceptance.mjs --backend-only",
    "verify:connected:acceptance:backend:web-push": "node scripts/verify-connected-acceptance.mjs --backend-only --include-web-push",
    "verify:connected:acceptance:deletion": "node scripts/verify-connected-acceptance.mjs --include-deletion",
    "verify:connected:acceptance:full": "node scripts/verify-connected-acceptance.mjs --include-web-push --include-deletion",
    "verify:connected:acceptance:web-push": "node scripts/verify-connected-acceptance.mjs --include-web-push",
    "verify:connected:config": "node scripts/verify-connected-acceptance.mjs --config-only",
    "verify:migrations": "node scripts/verify-migration-preservation.mjs",
    "verify:release:client-config": "node scripts/verify-release-client-config.mjs",
    "verify:release:readiness": "node scripts/verify-release-readiness.mjs",
    "verify:web-push": "node scripts/verify-web-push-protocol.mjs",
    "verify:supabase": "node scripts/verify-local-supabase-all.mjs",
    "verify:platform": "node scripts/verify-platform-config.mjs",
    "verify:performance": "vitest run src/performance/local-task-performance.test.ts --reporter=verbose",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/metro-runtime": "~57.0.7",
    "@expo/ui": "~57.0.7",
    "@organa/crypto": "workspace:*",
    "@organa/domain": "workspace:*",
    "@supabase/supabase-js": "^2.110.8",
    "base64-js": "^1.5.1",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.6",
    "idb": "8.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-android-widget": "0.21.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/base64-js": "^1.5.0",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.10",
    "web-push": "3.6.7",
    "workbox-cli": "^7.4.0"
  }
}
